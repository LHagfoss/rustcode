{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "identifier": "com.lhagfoss.rustcode.desktop",
  "bundle": {
    "externalBin": ["binaries/rustcode"],
    "targets": ["app", "nsis", "appimage", "deb"],
    "publisher": "RustCode",
    "homepage": "https://github.com/LHagfoss/rustcode",
    "shortDescription": "RustCode, the local coding agent",
    "macOS": { "minimumSystemVersion": "13.0", "signingIdentity": "-" },
    "windows": {
      "nsis": { "installMode": "currentUser", "startMenuFolder": "RustCode" }
    },
    "linux": {
      "deb": { "section": "devel" }
    }
  }
}

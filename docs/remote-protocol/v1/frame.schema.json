      "enum": [
        "queued",
        "running",
        "interrupted",
        "completed",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "RemoteTool": {
      "properties": {
        "detail": {
          "description": "Short human label, e.g. the file or command.",
          "type": [
            "string",
            "null"
          ]

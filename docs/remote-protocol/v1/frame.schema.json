          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "thought_tokens_estimated": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "timing": {
          "anyOf": [
            {
              "$ref": "#/$defs/RemoteTurnTiming"
            },
            {
              "type": "null"
            }
          ]

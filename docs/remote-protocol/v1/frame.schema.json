    },
    "RemoteSessionInfo": {
      "properties": {
        "activity": {
          "$ref": "#/$defs/SessionActivity"
        },
        "attention": {
          "$ref": "#/$defs/RemoteAttention"
        },
        "health": {
          "$ref": "#/$defs/OwnerHealth"
        },
        "model": {
          "type": "string"
        },
        "registration_epoch": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "session_id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "turn_count": {
          "description": "Total logical turns across the full host transcript, including an active turn.\nAbsent when an archived prefix prevents an exact total.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "workspace": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "session_id",
        "registration_epoch",
        "title",
        "model",
        "activity",
        "attention",
        "health"
      ],
      "type": "object"
    },
    "RemoteSessionSettings": {
      "description": "Safe session controls: never contains endpoint URLs or credentials.",
      "properties": {
        "can_change": {
          "type": "boolean"
        },
        "models": {
          "items": {
            "$ref": "#/$defs/RemoteModelOption"
          },
          "type": "array"
        },
        "reasoning_effort": {
          "description": "`default` means omit the provider effort override, not disable thinking.",
          "type": "string"
        },
        "selected_model": {
          "type": "string"
        }
      },
      "required": [
        "models",
        "selected_model",
        "reasoning_effort",
        "can_change"
      ],
      "type": "object"
    },
    "RemoteSessionsFrame": {
      "description": "Pushed after `subscribe_sessions` whenever the live list changes.",
      "properties": {
        "gateway_id": {
          "type": "string"
        },
        "instance_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "protocol_version": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "sessions": {
          "items": {
            "$ref": "#/$defs/RemoteSessionInfo"
          },
          "type": "array"
        }
      },
      "required": [
        "protocol_version",
        "gateway_id",
        "sessions"
      ],
      "type": "object"
    },
    "RemoteSnapshot": {
      "description": "Bounded view of one session. `sequence` is the exact watermark: the\nsnapshot already contains every event up to and including it.",
      "properties": {
        "background_tasks": {
          "items": {
            "$ref": "#/$defs/RemoteBackgroundTask"
          },
          "type": "array"
        },
        "generation": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "history_cursor": {
          "description": "Fetches the page before `transcript`; absent when nothing is older.",
          "type": [
            "string",
            "null"
          ]
        },
        "history_revision": {
          "description": "Identifies the transcript the message IDs and cursors refer to.",
          "type": "string"
        },
        "last_turn": {
          "anyOf": [
            {
              "$ref": "#/$defs/RemoteTurnTiming"
            },
            {
              "type": "null"
            }
          ],
          "description": "Latest terminal logical turn, including turns with no assistant answer."
        },
        "omitted": {
          "$ref": "#/$defs/RemoteOmitted",
          "description": "Counts of entries left out of the lists above to fit the frame."
        },
        "pending_approval": {
          "anyOf": [
            {
              "$ref": "#/$defs/RemoteApprovalBatch"
            },
            {
              "type": "null"
            }
          ]
        },
        "pending_prompts": {
          "items": {
            "$ref": "#/$defs/RemotePendingPrompt"
          },
          "type": "array"
        },
        "pending_question": {
          "anyOf": [
            {
              "$ref": "#/$defs/RemoteQuestion"
            },
            {
              "type": "null"
            }
          ]
        },
        "sequence": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "session": {
          "$ref": "#/$defs/RemoteSessionInfo"
        },
        "settings": {
          "anyOf": [
            {
              "$ref": "#/$defs/RemoteSessionSettings"
            },
            {
              "type": "null"
            }
          ]
        },
        "snapshot_id": {
          "description": "Opaque gateway identity for this snapshot cut, including replacements\nat the same sequence. Store alongside the reconnect cursor.",
          "type": [
            "string",
            "null"
          ]
        },
        "subagents": {
          "items": {
            "$ref": "#/$defs/RemoteSubagent"
          },
          "type": "array"
        },
        "transcript": {
          "description": "Transcript tail, oldest first.",
          "items": {
            "$ref": "#/$defs/RemoteMessage"
          },
          "type": "array"
        },
        "turn": {
          "anyOf": [
            {
              "$ref": "#/$defs/RemoteTurn"
            },
            {
              "type": "null"
            }
          ],
          "description": "Present while a prompt is being run. Absent in the short gap between\na prompt being accepted and its turn starting, even though\n`session.activity` is already `running`."
        }
      },
      "required": [
        "session",
        "sequence",
        "generation",
        "transcript",
        "history_revision",
        "pending_prompts",
        "subagents",
        "background_tasks",
        "omitted"
      ],
      "type": "object"
    },
    "RemoteSubagent": {
      "properties": {
        "active_turn": {
          "type": "boolean"
        },
        "depth": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "message_count": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "parent_id": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "status": {

        },
        "started_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "turn_id": {
          "type": "string"
        }
      },
      "required": [
        "turn_id"
      ],
      "type": "object"
    },
    "ResyncReason": {
      "oneOf": [
        {
          "enum": [
            "gateway_restarted"
          ],
          "type": "string"
        },
        {
          "const": "lagged",
          "description": "The subscriber fell behind the replay ring.",
          "type": "string"
        },
        {
          "const": "sequence_gap",
          "description": "The requested range is no longer contiguous.",
          "type": "string"
        },
        {
          "const": "history_changed",
          "description": "The transcript was rewritten; history cursors are invalid.",
          "type": "string"
        }
      ]
    },
    "SessionActivity": {
      "enum": [
        "idle",
        "running",
        "awaiting_approval",
        "awaiting_question"
      ],
      "type": "string"
    },
    "SessionCloseReason": {
      "oneOf": [
        {
          "enum": [
            "sharing_disabled",
            "owner_exited",
            "device_revoked"
          ],
          "type": "string"
        },
        {
          "const": "session_changed",
          "description": "The terminal moved to another session.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Host → client.",
  "oneOf": [
    {
      "$ref": "#/$defs/RemoteResponse",
      "properties": {
        "kind": {
          "const": "response",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    {
      "$ref": "#/$defs/RemoteEventFrame",
      "properties": {
        "kind": {
          "const": "event",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    {
      "$ref": "#/$defs/RemoteSessionsFrame",
      "properties": {
        "kind": {
          "const": "sessions",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    }
  ],
  "title": "RemoteFrame"
}
